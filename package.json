{
  "name": "sushi-rush",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:emu": "NEXT_PUBLIC_USE_EMULATORS=1 NEXT_PUBLIC_ENABLE_GUEST=1 next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:rules": "npx -y firebase-tools@15 emulators:exec --only firestore --project demo-sushi-rush \"vitest run tests/rules\"",
    "emulators": "npx -y firebase-tools@15 emulators:start --only auth,firestore --project demo-sushi-rush",
    "bot": "node scripts/bot.mjs",
    "seed": "node scripts/seed.mjs"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "lucide-react": "^1.51.0",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
