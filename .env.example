# La configuración web de Firebase no es secreta; estos valores sólo hacen falta
# si quieres apuntar a otro proyecto. Por defecto se usa sushi-e3a2b.
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=

# Muestra "Entrar como invitado". Requiere activar el proveedor Anónimo en Firebase Auth.
# NEXT_PUBLIC_ENABLE_GUEST=1

# Desarrollo local contra los emuladores de Firebase (npm run emulators).
# NEXT_PUBLIC_USE_EMULATORS=1
